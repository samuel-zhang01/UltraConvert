# frozen_string_literal: true

# Conversion engines and an isolated Python environment for the native app.
class UltraconvertRuntime < Formula
  include Language::Python::Virtualenv

  desc "Local conversion engines and Python runtime for UltraConvert"
  homepage "https://github.com/samuel-zhang01/UltraConvert"
  url "https://github.com/samuel-zhang01/UltraConvert/releases/download/v@VERSION@/UltraConvert-@VERSION@-source.tar.gz"
  sha256 "@SOURCE_SHA256@"
  license "MIT"

  depends_on "ffmpeg-full"
  depends_on "gdal"
  depends_on "imagemagick"
  depends_on "libyaml"
  depends_on "mac"
  depends_on macos: :ventura
  depends_on "pandoc"
  depends_on "python@3.15"

  resource "pyyaml" do
    url "https://files.pythonhosted.org/packages/05/8e/961c0007c59b8dd7729d542c61a4d537767a59645b82a0b521206e1e25c2/pyyaml-6.0.3.tar.gz"
    sha256 "d76623373421df22fb4cf8817020cbb7ef15c725b9d5e45f17e189bfc384190f"
  end

  resource "tomli-w" do
    url "https://files.pythonhosted.org/packages/c7/18/c86eb8e0202e32dd3df50d43d7ff9854f8e0603945ff398974c1d91ac1ef/tomli_w-1.2.0-py3-none-any.whl"
    sha256 "188306098d013b691fcadc011abd66727d3c414c571bb01b1a174ba8c983cf90"
  end

  resource "defusedxml" do
    url "https://files.pythonhosted.org/packages/07/6c/aa3f2f849e01cb6a001cd8554a88d4c77c5c1a31c95bdf1cf9301e6d9ef4/defusedxml-0.7.1-py2.py3-none-any.whl"
    sha256 "a352e7e428770286cc899e2542b6cdaedb2b4953ff269a210103ec58f6198a61"
  end

  def install
    venv = virtualenv_create(libexec, "python3.15", system_site_packages: true)
    # PyYAML's pure-Python implementation works without ABI-specific wheels.
    resource("pyyaml").stage do
      venv.site_packages.install "lib/yaml"
      (pkgshare/"licenses").install "LICENSE" => "PyYAML.txt"
    end
    # Homebrew verifies and fetches resources before entering the build sandbox.
    %w[tomli-w defusedxml].each do |name|
      resource = resource(name)
      wheel = buildpath/resource.downloader.basename
      cp resource.cached_download, wheel
      venv.pip_install wheel, build_isolation: false
    end
    (libexec/"src").install Dir["src/*.py"], "src/policy.xml"
    (libexec/"scripts").install "scripts/homebrew_integrations.py"
    (bin/"ultraconvert-engine").write <<~SH
      #!/bin/sh
      exec "#{opt_libexec}/bin/python" -E -s -B "#{opt_libexec}/src/convert.py" "$@"
    SH
    (bin/"ultraconvert-remove-finder-actions").write <<~SH
      #!/bin/sh
      exec "#{opt_libexec}/bin/python" -E -s -B "#{opt_libexec}/scripts/homebrew_integrations.py" "$@"
    SH
    (bin/"ultraconvert-engine").chmod 0755
    (bin/"ultraconvert-remove-finder-actions").chmod 0755
  end

  test do
    input = testpath/"settings.json"
    input.write('{"enabled":true,"value":7}')
    inspected = JSON.parse(shell_output("#{bin}/ultraconvert-engine --inspect #{input}"))
    assert_equal "config", inspected.fetch("files").first.fetch("category")
    assert_equal "json", inspected.fetch("files").first.fetch("format")
    assert_nil inspected.fetch("files").first.fetch("error")
    system bin/"ultraconvert-engine", "--to", "yaml", "--here", "--reports-dir", testpath/"reports", input
    assert_path_exists testpath/"settings.yaml"
    assert_equal '{"enabled":true,"value":7}', input.read
    system libexec/"bin/python", "-I", "-B", "-c",
           "from osgeo import gdal; import sys, yaml, tomli_w, defusedxml; " \
           "assert yaml.safe_load(open(sys.argv[1])) == {'enabled': True, 'value': 7}",
           testpath/"settings.yaml"
  end
end
